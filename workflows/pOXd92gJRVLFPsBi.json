    {
      "parameters": {
        "jsCode": "const seen = new Set($('Seen IDs').all().map(i => i.json.gmail_id).filter(Boolean));\n\nconst mask = s => String(s ?? '')\n  .replace(/[\\u200B-\\u200F\\u2060\\uFEFF\\u034F\\u00AD]/g, '')\n  .replace(/https?:\\/\\/\\S+/gi, '[link]')\n  .replace(/\\b\\d{4,8}\\b/g, '[code]')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nreturn $('Gmail').all()\n  .filter(i => !seen.has(i.json.id))\n  .map(i => ({ json: {\n    gmail_id: i.json.id,\n    thread_id: i.json.threadId,\n    from: i.json.From,\n    received_at: new Date(Number(i.json.internalDate)).toISOString(),\n    subject: mask(i.json.Subject),\n    snippet: mask(i.json.snippet),\n  }}));"
      },
