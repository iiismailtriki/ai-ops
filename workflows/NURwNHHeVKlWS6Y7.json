      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, category, priority, summary, from_addr, suspicious\nFROM emails\nWHERE notified_at IS NULL\nORDER BY priority, received_at DESC\nLIMIT 50;",
        "options": {}
      },
