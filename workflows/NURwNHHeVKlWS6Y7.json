      "executeOnce": true,
      "alwaysOutputData": false,
      "credentials": {
        "postgres": {
          "id": "zQ2Vb2q5uv7hL8b6",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst icons = { urgent: '🔴', job: '💼', admin: '📋', social: '👥', newsletter: '📰' };\nconst order = ['urgent', 'job', 'admin', 'social', 'newsletter'];\nconst date = new Date().toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'short', timeZone: 'Europe/Berlin' });\nconst sender = r => String(r.from_addr || '').replace(/<.*>/, '').replace(/\"/g, '').trim() || 'unknown';\n\nconst lines = [`☀️ Inbox digest, ${date}`, `${rows.length} new emails`, ''];\n\nconst sus = rows.filter(r => r.suspicious);\nif (sus.length) {\n  lines.push(`⚠️ SUSPICIOUS (${sus.length}), do not act on these`);\n  sus.forEach(r => lines.push(`• ${sender(r)}`));\n  lines.push('');\n}\n\nfor (const cat of order) {\n  const items = rows.filter(r => r.category === cat && !r.suspicious);\n  if (!items.length) continue;\n  lines.push(`${icons[cat]} ${cat.toUpperCase()} (${items.length})`);\n  if (cat === 'newsletter') { lines.push('  skipped, low priority', ''); continue; }\n  items.forEach(r => lines.push(`• ${r.summary} (${sender(r)})`));\n  lines.push('');\n}\n\nlet text = lines.join('\\n');\nif (text.length > 3900) text = text.slice(0, 3900) + '\\n… (truncated)';\nreturn [{ json: { text, ids: rows.map(r => r.id).join('|') } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
